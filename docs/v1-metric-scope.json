  "interpretation_boundary": {
    "allowed_claim": "descriptive properties of a submitted text under recorded tokenizer, Panel B mapping method, normalizer, resource versions, lookup units, and parameters",
    "prohibited_claims": [
      "grade or essay score",
      "CEFR level",
      "vocabulary knowledge diagnosis",
      "writer proficiency estimate",
      "writing quality prediction",
      "AI authorship detection"
    ],
    "comparison_requirements": [
      "identical tokenizer, Panel B mapping method ID, normalizer, resource versions, lookup units, and parameters",
      "prefer comparable text length, prompt, topic, genre, register, and sampling conditions",
      "report coverage and missingness with conditional means"
    ],
    "higher_or_lower_is_automatically_better": false,
    "automatic_warnings_are_validated_cut_scores": false,
    "panel_b_off_list_means_unknown_to_reader": false,
    "tubelex_is_coca_or_a_balanced_proficiency_norm": false,
    "oewn_inventory_senses_are_contextual_senses_used": false
  },
  "non_goals": [
    {
      "id": "ellipse_rating_prediction",
      "rule": "ELLIPSE may be used only in an offline external-association study; no fitted rating model, score field, or runtime dependency enters v1.0."
    },
    {
      "id": "cefr_grade_quality_or_proficiency_prediction",
      "rule": "No classifier, regressor, composite score, or UI label for these outcomes."
    },
    {
      "id": "ai_authorship_detection",
      "rule": "The tool is not an AI detector."
    },
    {
      "id": "future_masc_oanc_dispersion_metrics",
      "rule": "MASC/OANC document frequency, generic contextual diversity, dispersion tuples, register entropy, and association metrics remain post-v1 until implemented and admitted."
    },
    {
      "id": "tubelex_category_entropy",
      "rule": "Raw or adjusted category entropy is excluded pending a validated shrinkage or Jensen-Shannon design."
    },
    {
      "id": "pos_aware_or_contextual_semantics",
      "rule": "POS tagging, contextual sense disambiguation, and contextual semantic sophistication are not provided."
    },
    {
      "id": "complete_taales_or_coca_replication",
      "rule": "No claim of complete TAALES reconstruction or numerical equivalence to COCA-based TAALES indices."
    },
    {
      "id": "permission_pending_runtime_resources",
      "rule": "AntBNC, legacy EAPFoundation data, legacy TAALES tables, and user-supplied Range data are not public-v1 runtime resources."
    }
  ],
  "semver": {
    "consumer_rule": "Consumers of 1.x JSON should ignore unknown additive fields but may rely on every frozen key and its meaning remaining present.",
    "major": {
      "required_for": [
        "remove or rename a metric, JSON field, Excel sheet, or frozen column",
        "change a metric formula, denominator, weighting, counting unit, tokenizer semantics, lookup semantics, or interpretation construct",
        "change a field type, nullability rule, nesting, or meaning incompatibly",
        "replace or remove a pinned runtime resource identity without retaining the old option",
        "change an existing default in a way that changes existing-config output",
        "weaken the aggregate-only privacy boundary"
      ]
    },
    "minor": {
      "allowed_for": [
        "add an optional metric or optional namespaced field while preserving all frozen behavior",
        "append an Excel column without reordering frozen columns",
        "add a new green resource under a new identity while retaining old resource identities and defaults",
        "add an interpretation card or non-breaking warning"
      ],
      "required_gates": [
        "method and interpretation card",
        "rights and provenance review",
        "deterministic or bounded-nondeterministic tests",
        "schema and migration-note update"
      ]
    },
    "patch": {
      "allowed_for": [
        "documentation, citation, test, performance, packaging, or security fixes that do not change the frozen schema or intended metric semantics",
        "a bug fix that restores an already frozen formula without changing keys, defaults, or resource identity"
      ],
      "numerical_bugfix_rule": "Any numerical delta must be declared in release notes, covered by updated golden fixtures, and must not rewrite an already published immutable release."
    }
  },
  "change_gate": {
    "scope_json_and_japanese_document_updated_together": true,
    "cross_check_test_must_pass": "tests/test_v1_metric_scope.py",
    "public_release_inventory_gate_must_pass": "scripts/check_public_release.py",
    "new_metric_requires_incremental_interpretive_value": true,
    "new_resource_requires_green_status_and_reproducible_identity": true
  }
}
