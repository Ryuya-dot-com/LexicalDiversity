        "ttr",
        "rttr",
        "cttr",
        "herdan",
        "maas",
        "msttr",
        "mattr",
        "mtld",
        "hdd",
        "vocd",
        "yule_k",
        "yule_i"
      ],
      "diversity_direction": {
        "ttr": 1,
        "rttr": 1,
        "cttr": 1,
        "herdan": 1,
        "maas": -1,
        "msttr": 1,
        "mattr": 1,
        "mtld": 1,
        "hdd": 1,
        "vocd": 1,
        "yule_k": -1,
        "yule_i": 1
      },
      "project_minimum_tokens": {
        "ttr": 1,
        "rttr": 1,
        "cttr": 1,
        "herdan": 2,
        "maas": 2,
        "msttr": 50,
        "mattr": 50,
        "mtld": 50,
        "hdd": 42,
        "vocd": 50,
        "yule_k": 100,
        "yule_i": 100
      },
      "computational_minimum_tokens_at_default_parameters": {
        "ttr": 1,
        "rttr": 1,
        "cttr": 1,
        "herdan": 2,
        "maas": 2,
        "msttr": 50,
        "mattr": 50,
        "mtld": 10,
        "hdd": 42,
        "vocd": 50,
        "yule_k": 1,
        "yule_i": 1
      },
      "method_ids": {
        "ttr": "ttr_v_over_n_v1",
        "rttr": "rttr_guiraud_v_over_sqrt_n_v1",
        "cttr": "cttr_v_over_sqrt_2n_v1",
        "herdan": "herdan_c_logv_over_logn_v1",
        "maas": "maas_a2_ln_v1",
        "msttr": "msttr_nonoverlap_complete_drop_v1",
        "mattr": "mattr_sliding_step1_v1",
        "mtld": "mtld_bidir_mean_leq_min10_python_v1",
        "hdd": "hdd_expected_ttr_scaled_v1",
        "vocd": "vocd_d_monte_carlo_python_v1",
        "yule_k": "yule_k_m2_tokens_v1",
        "yule_i": "yule_i_types_v2_over_m2_minus_v_v1"
      },
      "record_keys": [
        "value",
        "status",
        "missing_reason",
        "method_id",
        "requested_parameters",
        "effective_parameters",
        "advisory_quality_floor_tokens",
        "advisory_quality_status"
      ],
      "status_values": [
        "available",
        "missing"
      ],
      "missing_reason_values": [
        "empty_input",
        "insufficient_tokens_for_formula",
        "too_short_for_requested_parameter",
        "no_convergence",
        "zero_denominator",
        "no_factor",
        "undefined_for_text"
      ],
      "parameter_policy": {
        "standard_method_ids_never_shrink_requested_parameters": true,
        "missing_result_effective_parameters": {},
        "available_standard_result_effective_parameters_equal_requested": true,
        "advisory_quality_floor_controls_computation": false,
        "adaptive_variants_are_public_defaults": false,
        "public_boolean_parameters_require_exact_bool": true,
        "public_token_input": "materialized_sequence_of_nonempty_utf8_strings",
        "bare_string_bytes_generators_and_non_string_items_rejected": true,
        "invalid_parameters_raise": "ValueError_or_TypeError_before_computation",
        "retained_adaptive_api_keys": [
          "msttr_adaptive",
          "mattr_adaptive",
          "hdd_adaptive",
          "vocd_adaptive"
        ],
        "mtld_python_factor_boundary_comparator": "<=",
        "mtld_python_minimum_factor_length": 10,
        "record_api_mtld_minimum_factor_length_is_fixed": true,
        "mtld_cross_language_numerical_equivalence_claim": false
      }
    },
